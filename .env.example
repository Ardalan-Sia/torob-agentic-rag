# Optional override. The default location is auto-detected from the repository root.
PHASE1_ARTIFACTS_DIR=phase1/torob_rag/artifacts

# Optional OpenRouter-compatible intent classification and response rewriting.
# The deterministic local agent works when this key is empty.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_ENABLE_INTENT=0
LLM_TIMEOUT_SECONDS=20

# Optional OpenTelemetry/Phoenix tracing.
ENABLE_OTEL=0
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces

# Optional request-time CLIP image retrieval.
ENABLE_CLIP_IMAGE_RETRIEVAL=0
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
